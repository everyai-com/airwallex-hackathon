# Airwallex sandbox credentials (Account > Developer > API keys)
AWX_CLIENT_ID=
AWX_API_KEY=

# Set MOCK=1 to run every kit against the in-memory sandbox simulator.
# Leave empty (or 0) to call the real sandbox at api.sandbox.airwallex.com.
MOCK=

# Optional overrides
# AWX_BASE_URL=https://api.sandbox.airwallex.com
# AWX_FILES_URL=https://files.sandbox.airwallex.com
# AWX_DATA_DIR=.data
