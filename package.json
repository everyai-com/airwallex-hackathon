{
  "name": "airwallex-hackathon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "setup": "tsx src/cli.ts setup",
    "kit1": "tsx src/cli.ts kit1",
    "demo": "tsx src/cli.ts kit1",
    "kit2": "tsx src/cli.ts kit2",
    "kit3": "tsx src/cli.ts kit3",
    "kit4": "tsx src/cli.ts kit4",
    "kit5": "tsx src/cli.ts kit5",
    "kit6": "tsx src/cli.ts kit6",
    "kit7": "tsx src/cli.ts kit7",
    "kit8": "tsx src/cli.ts kit8",
    "kit9": "tsx src/cli.ts kit9",
    "kit10": "tsx src/cli.ts kit10",
    "kit11": "tsx src/cli.ts kit11",
    "kit12": "tsx src/cli.ts kit12",
    "kit13": "tsx src/cli.ts kit13",
    "kit14": "tsx src/cli.ts kit14",
    "kit15": "tsx src/cli.ts kit15",
    "kit16": "tsx src/cli.ts kit16",
    "kit17": "tsx src/cli.ts kit17",
    "kit18": "tsx src/cli.ts kit18",
    "all": "tsx src/cli.ts all",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npx tsx src/cli.ts all --mock > /dev/null"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
