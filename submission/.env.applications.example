# Copy this file to submission/.env.applications and fill in your details.
# Used only by submission/send-applications.mjs to prefill email drafts.
# This file is gitignored — never commit it.

# The email address on your sandbox.airwallex.com account
AWX_SANDBOX_EMAIL=

# Client ID from Account > Developer > API keys (NOT the API key)
AWX_CLIENT_ID=

# The email address on your app.airi.com account (create one first)
AIRI_EMAIL=
